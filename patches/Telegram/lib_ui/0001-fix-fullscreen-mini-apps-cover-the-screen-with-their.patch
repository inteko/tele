From: nitreojs <hello@starkow.dev>
Date: Sun, 4 Oct 2026 23:01:10 +0300
Subject: [PATCH] fix: fullscreen mini apps cover the screen with their buttons

---
 ui/ui_utility.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/ui/ui_utility.cpp b/ui/ui_utility.cpp
index b067d4d99871740133bf3db3b99a2b7615644059..6f257fc45033995dc9072c3b4265279f6a4b7d80 100644
--- a/ui/ui_utility.cpp
+++ b/ui/ui_utility.cpp
@@ -263,6 +263,13 @@ void SetGeometryAndScreen(
 #endif // Qt < 6.0.0
 	}
 	widget->setGeometry(geometry);
+#if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
+	if (widget->isWindow() && !widget->isVisible()) {
+		if (const auto window = widget->windowHandle()) {
+			window->setGeometry(geometry);
+		}
+	}
+#endif // Qt < 6.0.0
 }
 
 QPointF ScrollDeltaF(not_null<QWheelEvent*> e, bool touch) {
