+	auto context = MakeContext(window, Target::Window);
 	context.label = &label.tokens;
 	return RenderIn(Parse(source, true).tokens, context).value_or(QString());
 }
@@ -270,17 +276,23 @@ std::optional<QString> WindowTitleText(not_null<Window::Controller*> window) {
 	return text.isEmpty() ? u" "_q : text;
 }
 
+bool WindowTitleLocked() {
+	return Core::App().passcodeLocked() || StreamerMode();
+}
+
 rpl::producer<> WindowTitleChanges(not_null<Window::Controller*> window) {
-	return WindowTitleTemplateValue(
-	) | rpl::map([](const QString &source) {
-		return source.isEmpty();
-	}) | rpl::distinct_until_changed(
-	) | rpl::map([=](bool empty) -> rpl::producer<> {
-		if (empty) {
-			return rpl::single(rpl::empty);
-		}
-		return LiveText(window, Target::Window) | rpl::to_empty;
-	}) | rpl::flatten_latest();
+	return rpl::merge(
+		WindowTitleTemplateValue(
+		) | rpl::map([](const QString &source) {
+			return source.isEmpty();
+		}) | rpl::distinct_until_changed(
+		) | rpl::map([=](bool empty) -> rpl::producer<> {
+			if (empty) {
+				return rpl::single(rpl::empty);
+			}
+			return LiveText(window, Target::Window) | rpl::to_empty;
+		}) | rpl::flatten_latest(),
+		StreamerModeValue() | rpl::skip(1) | rpl::to_empty);
 }
 
 } // namespace Tele
