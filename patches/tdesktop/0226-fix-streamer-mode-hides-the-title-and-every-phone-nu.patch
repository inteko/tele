 			if (target == Target::Window) {
 				context.label = &state->label.tokens;
 			}
@@ -244,8 +249,9 @@ QString TitleText(not_null<Window::Controller*> window) {
 QString PreviewTitleText(
 		not_null<Window::Controller*> window,
 		const QString &source) {
