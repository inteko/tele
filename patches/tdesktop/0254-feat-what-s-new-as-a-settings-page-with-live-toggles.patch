+base::weak_qptr<Ui::RpWidget> NewSection::createPinnedToTop(
+		not_null<QWidget*> parent) {
+	const auto wrap = Ui::CreateChild<Ui::VerticalLayout>(parent.get());
+	const auto skip = st::boxRowPadding.left() / 2;
+	_tabsWrap = wrap->add(object_ptr<Ui::SlideWrap<Ui::SubTabs>>(
+		wrap,
+		object_ptr<Ui::SubTabs>(
+			wrap,
+			st::defaultSubTabs,
+			Ui::SubTabs::Options{ .centered = true }),
+		QMargins(0, skip, 0, skip)));
+	_tabs = _tabsWrap->entity();
+	refreshTabs();
