+void AddNewText(
+		SectionBuilder &builder,
+		const TextWithEntities &text,
+		const style::FlatLabel &st,
+		QMargins margin,
+		bool fresh) {
+	builder.add([&](const WidgetContext &ctx) {
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto raw = result.data();
+		const auto label = raw->add(
+			object_ptr<Ui::FlatLabel>(raw, st),
+			margin);
+		label->setMarkedText(text);
+		if (fresh) {
+			const auto badge = Ui::NewBadge::CreateNewBadge(
+				raw,
+				rpl::single(::Tele::Lower(u"NEW"_q))).get();
+			label->geometryValue(
+			) | rpl::on_next([=](QRect geometry) {
+				const auto font = label->st().style.font;
+				const auto width = std::min(
+					label->textMaxWidth(),
+					geometry.width());
+				badge->moveToLeft(
+					geometry.x() + width + font->spacew,
+					geometry.y() + (font->height - badge->height()) / 2);
+			}, badge->lifetime());
+		}
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+			.align = style::al_justify,
+		};
+	}, nullptr);
+}
