 #include "window/window_session_controller.h"
 
 namespace Tele {
+namespace {
+
+using Flag = Data::ChatFilter::Flag;
+
+struct Covered {
+	Flag type = Flag();
+	bool covered = false;
+};
+
+using CoveredCache = std::unordered_map<not_null<History*>, Covered>;
+
+[[nodiscard]] std::map<
+		not_null<Main::Session*>,
+		CoveredCache> &Caches() {
+	static auto result = std::map<
+		not_null<Main::Session*>,
+		CoveredCache>();
+	return result;
+}
+
+[[nodiscard]] CoveredCache &CacheFor(not_null<Main::Session*> session) {
+	auto &caches = Caches();
+	const auto i = caches.find(session);
+	if (i != end(caches)) {
+		return i->second;
+	}
+	session->lifetime().add([=] {
+		Caches().erase(session);
+	});
+	return caches[session];
+}
+
+[[nodiscard]] Flag TypeFlag(not_null<History*> history) {
+	const auto peer = history->peer;
+	if (const auto user = peer->asUser()) {
+		return user->isBot()
+			? Flag::Bots
+			: user->isContact()
+			? Flag::Contacts
+			: Flag::NonContacts;
+	} else if (const auto channel = peer->asChannel()) {
+		return channel->isBroadcast() ? Flag::Channels : Flag::Groups;
+	}
+	return Flag::Groups;
+}
+
+[[nodiscard]] bool CoveredByOther(
+		not_null<History*> history,
+		Flag type) {
+	for (const auto &other : history->owner().chatsFilters().list()) {
+		const auto id = other.id();
+		if (!id
+			|| IsUnsortedFolder(id)
+			|| other.never().contains(history)) {
+			continue;
+		} else if ((other.flags() & type)
+			|| other.always().contains(history)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+} // namespace
 
 bool IsUnsortedFolder(FilterId id) {
 	return (id == kUnsortedFolderId);
@@ -33,8 +98,7 @@ Data::ChatFilter UnsortedFolderFilter() {
 
 std::optional<bool> UnsortedFolderContains(
 		const Data::ChatFilter &filter,
-		not_null<History*> history,
-		bool ignoreFakeUnread) {
+		not_null<History*> history) {
 	if (!IsUnsortedFolder(filter.id())) {
 		return std::nullopt;
 	} else if (!(filter.flags() & Data::ChatFilter::Flag::NoArchived)
@@ -46,18 +110,19 @@ std::optional<bool> UnsortedFolderContains(
 	if (channel && channel->isCommunity()) {
 		return false;
 	}
-	for (const auto &other : history->owner().chatsFilters().list()) {
-		const auto id = other.id();
-		if (id
-			&& !IsUnsortedFolder(id)
-			&& other.contains(history, ignoreFakeUnread)) {
-			return false;
-		}
+	const auto type = TypeFlag(history);
+	auto &cache = CacheFor(&history->session());
+	const auto i = cache.find(history);
+	if (i != end(cache) && i->second.type == type) {
+		return !i->second.covered;
 	}
-	return true;
+	const auto covered = CoveredByOther(history, type);
+	cache[history] = Covered{ .type = type, .covered = covered };
+	return !covered;
 }
 
 void RefreshUnsortedFolder(not_null<Main::Session*> session) {
+	CacheFor(session).clear();
 	const auto owner = &session->data();
 	const auto filters = &owner->chatsFilters();
 	const auto &list = filters->list();
