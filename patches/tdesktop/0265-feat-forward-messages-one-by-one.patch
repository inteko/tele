@@ -684,7 +685,8 @@ std::vector<ForwardRange> CollectForwardRanges(
 			continue;
 		}
 		if (result.empty()
-			|| result.back().fromEphemeral != fromEphemeral) {
+			|| result.back().fromEphemeral != fromEphemeral
