diff --git a/Telegram/SourceFiles/tele/tele_forward.cpp b/Telegram/SourceFiles/tele/tele_forward.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bb38609ee3c81c52ed6416ce84f3d41e8714cca4
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_forward.cpp
@@ -0,0 +1,18 @@
+#include "tele/tele_forward.h"
+
+#include "history/history_item.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+
+bool ForwardSeparately(
+		not_null<HistoryItem*> previous,
+		not_null<HistoryItem*> item) {
+	if (!ForwardOneByOne()) {
+		return false;
+	}
+	const auto group = item->groupId();
+	return !group || (previous->groupId() != group);
+}
+
+} // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_forward.h b/Telegram/SourceFiles/tele/tele_forward.h
new file mode 100644
index 0000000000000000000000000000000000000000..1cc5ad46b3933a7628bf4ac0a4f5c95b5eed2a62
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_forward.h
@@ -0,0 +1,11 @@
+#pragma once
+
+class HistoryItem;
+
+namespace Tele {
+
+[[nodiscard]] bool ForwardSeparately(
+	not_null<HistoryItem*> previous,
+	not_null<HistoryItem*> item);
+
+} // namespace Tele
