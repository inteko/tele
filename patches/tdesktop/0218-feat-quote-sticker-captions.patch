From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 4 Oct 2026 11:05:17 +0300
Subject: [PATCH] feat: quote sticker captions

---
 .../history/view/history_view_message.cpp           |  6 ++++++
 .../view/media/history_view_media_unwrapped.cpp     | 13 +++++++++++++
 .../view/media/history_view_media_unwrapped.h       |  3 +++
 Telegram/SourceFiles/tele/tele_sticker_captions.cpp | 13 +++++++++++++
 Telegram/SourceFiles/tele/tele_sticker_captions.h   |  5 +++++
 5 files changed, 40 insertions(+)

diff --git a/Telegram/SourceFiles/history/view/history_view_message.cpp b/Telegram/SourceFiles/history/view/history_view_message.cpp
index 5f4e20d9bccdfe1958e737e0fa528d6b8e362c7f..dedc19267e448df3b24daf6d4e27593facc233e8 100644
--- a/Telegram/SourceFiles/history/view/history_view_message.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_message.cpp
@@ -2198,10 +2198,16 @@ void Message::draw(Painter &p, const PaintContext &context) const {
 			media->paintBubbleFireworks(p, g, context.now);
 		}
 	} else if (media && media->isDisplayed()) {
+		const auto maybeMediaHighlight = context.highlightPathCache
+			&& context.highlightPathCache->isEmpty();
 		p.translate(g.topLeft());
 		media->draw(p, context.translated(
 			-g.topLeft()
 		).withSelection(skipTextSelection(context.selection)));
+		if (maybeMediaHighlight
+			&& !context.highlightPathCache->isEmpty()) {
+			context.highlightPathCache->translate(g.topLeft());
+		}
 		if (context.reactionInfo && !_reactions) {
 			const auto add = QPoint(0, g.height());
 			context.reactionInfo->position = g.topLeft() + add;
diff --git a/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.cpp b/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.cpp
index 3ae028ea309859f377120746b93f0d4c56b6959c..e75dd51efbe740b0a508e6d0d40fc80049204386 100644
--- a/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.cpp
+++ b/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.cpp
@@ -62,6 +62,19 @@ TextForMimeData UnwrappedMedia::selectedText(TextSelection selection) const {
 		: TextForMimeData();
 }
 
+SelectedQuote UnwrappedMedia::selectedQuote(TextSelection selection) const {
+	return _teleCaption
+		? _teleCaption->selectedQuote(selection)
+		: SelectedQuote();
+}
+
+TextSelection UnwrappedMedia::selectionFromQuote(
+		const SelectedQuote &quote) const {
+	return _teleCaption
+		? _teleCaption->selectionFromQuote(quote)
+		: TextSelection();
+}
+
 TextSelection UnwrappedMedia::adjustSelection(
 		TextSelection selection,
 		TextSelectType type) const {
diff --git a/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.h b/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.h
index c05dd4ac9815c93e6cd1b2c6f599392038b0a9b0..6e2ea3ae09604619e193093d19c2ab265df3d0fb 100644
--- a/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.h
+++ b/Telegram/SourceFiles/history/view/media/history_view_media_unwrapped.h
@@ -83,6 +83,9 @@ public:
 
 	bool hasTextForCopy() const override;
 	TextForMimeData selectedText(TextSelection selection) const override;
+	SelectedQuote selectedQuote(TextSelection selection) const override;
+	TextSelection selectionFromQuote(
+		const SelectedQuote &quote) const override;
 	TextSelection adjustSelection(
 		TextSelection selection,
 		TextSelectType type) const override;
diff --git a/Telegram/SourceFiles/tele/tele_sticker_captions.cpp b/Telegram/SourceFiles/tele/tele_sticker_captions.cpp
index 512f296125de81f906d8f1d578eaff6cf3b79392..0c0ab12786839894b537fce9a767c3178f489a37 100644
--- a/Telegram/SourceFiles/tele/tele_sticker_captions.cpp
+++ b/Telegram/SourceFiles/tele/tele_sticker_captions.cpp
@@ -285,6 +285,19 @@ TextForMimeData StickerCaption::selectedText(TextSelection selection) const {
 	return _text.toTextForMimeData(selection);
 }
 
+HistoryView::SelectedQuote StickerCaption::selectedQuote(
+		TextSelection selection) const {
+	return HistoryView::Element::FindSelectedQuote(
+		_text,
+		selection,
+		_view->data());
+}
+
+TextSelection StickerCaption::selectionFromQuote(
+		const HistoryView::SelectedQuote &quote) const {
+	return HistoryView::Element::FindSelectionFromQuote(_text, quote);
+}
+
 TextSelection StickerCaption::adjustSelection(
 		TextSelection selection,
 		TextSelectType type) const {
diff --git a/Telegram/SourceFiles/tele/tele_sticker_captions.h b/Telegram/SourceFiles/tele/tele_sticker_captions.h
index d32af459ac4da829019f7cde6a27927149f4755c..ef23c114aec50b906cb1316f621694549ddb2e9e 100644
--- a/Telegram/SourceFiles/tele/tele_sticker_captions.h
+++ b/Telegram/SourceFiles/tele/tele_sticker_captions.h
@@ -22,6 +22,7 @@ class Media;
 
 namespace HistoryView {
 class Element;
+struct SelectedQuote;
 struct TextState;
 struct StateRequest;
 struct ItemPreview;
@@ -68,6 +69,10 @@ public:
 
 	[[nodiscard]] TextForMimeData selectedText(
 		TextSelection selection) const;
+	[[nodiscard]] HistoryView::SelectedQuote selectedQuote(
+		TextSelection selection) const;
+	[[nodiscard]] TextSelection selectionFromQuote(
+		const HistoryView::SelectedQuote &quote) const;
 	[[nodiscard]] TextSelection adjustSelection(
 		TextSelection selection,
 		TextSelectType type) const;
